# Neon Postgres connection string (provided automatically by the Vercel Neon integration)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Admin portal (/admin). Google OAuth Web client ID (Google Cloud console > Credentials).
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Comma-separated Google accounts allowed into /admin.
ADMIN_EMAILS=you@gmail.com
